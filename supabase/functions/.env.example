# Secretos de las Edge Functions (livekit-token, livekit-webhook).
# NO van en el .env del frontend: Vite expone al navegador todo lo que empiece
# con VITE_, y LIVEKIT_API_SECRET jamás debe llegar ahí.
#
# Producción: Supabase Dashboard → Edge Functions → Secrets (o
#   supabase secrets set --env-file supabase/functions/.env)
# Local:      copiar a supabase/functions/.env y ejecutar
#   supabase functions serve --env-file supabase/functions/.env
#
# Valores en cloud.livekit.io → tu proyecto → Settings → Keys.
LIVEKIT_URL=wss://tu-proyecto.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
